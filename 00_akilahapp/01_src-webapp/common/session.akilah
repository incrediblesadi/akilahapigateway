    type: "yaml"
  references:
    - section: "SESS_0915_0000_S2"
      type: "content_structure"
      purpose: "Defines retrievable content"
    - section: "SESS_0915_0000_S8_1"
      type: "asset_registry"
      purpose: "Asset catalog reference"
