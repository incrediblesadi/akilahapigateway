```yaml
# Content Retrieval Contract Implementation
implementation:
  contract:
    id: "SESS_0915_0000_S8_3_A3"
    type: "content_retrieval"
    version: "1.0.0"
    status: "active"
    purpose: "Retrieve content by section ID"

  content:
    retrieval:
      patterns:
        section: "SESS_\\d{4}_\\d{4}_S\\d+"
        subsection: "SESS_\\d{4}_\\d{4}_S\\d+_\\d+"
        note: "SESS_\\d{4}_\\d{4}_S\\d+_\\d+_N\\d+"
        asset: "SESS_\\d{4}_\\d{4}_S\\d+_\\d+_A\\d+"
        task: "SESS_\\d{4}_\\d{4}_S\\d+_\\d+_T\\d+"

      operations:
        get_section:
          pattern: "{section_id}"
          returns: "full_section_content"

        get_by_type:
          pattern: "type:{content_type}"
          returns: "content_list_by_type"

        get_tree:
          pattern: "tree/{section_id?}"
          returns: "hierarchical_view"

        search:
          pattern: "search/{term}"
          returns: "matching_sections"

      examples:
        - "retrieve SESS_0915_0000_S7_1"
        - "retrieve type:note"
        - "retrieve tree/SESS_0915_0000_S7"
        - "retrieve search/identity"

  validation:
    required: ["retrieval.patterns", "retrieval.operations"]
    schema_version: "1.0.0"
    requires_references: true
```
