CREATE TABLE IF NOT EXISTS database_metadata_core (
  db_path TEXT PRIMARY KEY,                -- full path is the UID
  action_type TEXT NOT NULL,               -- create | use_existing | update | retrieve

  -- PATH SELECTION / PLACEMENT
  path_selection_method TEXT,              -- manual | picker | recipe | system
  db_rel_path TEXT,                        -- optional relative path
  placement_root TEXT,                     -- e.g. /Users/Akilah/Desktop/runtime_alignment_engine/
  placement_category TEXT,                 -- e.g. governance | intelligence | workflows

  -- ATTACHMENT / DEPENDENCY
  is_attached INTEGER DEFAULT 0,           -- 0/1
  attached_to_db_path TEXT,                -- parent/linked DB
  depends_on_db_path TEXT,                 -- dependency link (if any)

  -- CREATION RECIPE (if action_type = create)
  creation_recipe TEXT,                    -- name of recipe/template (string)
  creation_recipe_params JSON,             -- optional params (JSON)

  created_at TEXT DEFAULT (datetime('now')),
  created_by TEXT                          -- user | system
);
</Staging>


