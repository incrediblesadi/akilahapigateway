                                            // port_number: 3000, 3001, 3002
                                            // capabilities: JSON array of tool definitions
                                            // bootstrap_status: pending/active/failed
                                            // server_class: maps to 7-class architecture
                                            // configuration: JSON server config, metadata
  ],

  '08-03 coordinate-based-queries': [
