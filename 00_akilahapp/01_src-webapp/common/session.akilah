                                            // instance_id: inst_copilot_001
                                            // workspace_name: runtime_alignment_engine
                                            // conversation_history: JSON array of turns
                                            // active_servers: JSON array of server states
                                            // auth_token, user_role, timestamps, metadata

    '08-02-02 DB01_T02_conversation_notes', // NOTE level coordination:
                                            // hierarchical_id: DB01_T02_E001, DB01_T02_E002
                                            // parent_hierarchical_id: DB01_T01_E001 (links to session)
                                            // note_content, note_type (general/system/error/debug)
                                            // conversation_turn: integer sequence number
                                            // user_prompt, ai_response, attachments (JSON)
                                            // session_id, instance_id, timestamps, metadata

    '08-02-03 DB01_T03_server_registry',    // SERVER level coordination:
                                            // hierarchical_id: DB01_T03_E001, DB01_T03_E002
                                            // parent_hierarchical_id: DB01_T01_E001 (links to session)
