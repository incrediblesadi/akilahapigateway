    'CONFIG_MANAGER': 'Reads DB01_T03_server_registry for server states and configuration',
    'PROTOCOL_LAYER': 'Logs communication events to DB01_T02_conversation_notes',
    'SERVER_CAPABILITIES': 'Updates capabilities JSON in DB01_T03_server_registry',
