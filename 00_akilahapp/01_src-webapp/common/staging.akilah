====================================================================================
-- TABLE 02: CAPABILITIES (The WHY - What Can We Do?)
-- ====================================================================================
-- Table: DB01_T02_capabilities
-- Purpose: Define WHAT is possible per platform and WHY we would want it
-- Entry Numbering: DB01_T02_G01_01_entry_001, DB01_T02_G01_01_entry_002, etc.
-- Flow: Start with WHY (business case), not HOW (integration type)
-- ====================================================================================

CREATE TABLE DB01_T02_capabilities (
  -- GROUP 01: CAPABILITY IDENTITY
  DB01_T02_G01_01_capability_uid TEXT PRIMARY KEY,
  DB01_T02_G01_02_entry_number INTEGER,
  DB01_T02_G01_03_name TEXT NOT NULL,                -- 'Social Media Posting', 'Real-Time Chat', 'Data Analytics'
  DB01_T02_G01_04_platform_uid TEXT NOT NULL,        -- FK to DB01_T01_platforms
  DB01_T02_G01_05_capability_type TEXT,              -- query, mutation, stream, batch, realtime, analytics
  DB01_T02_G01_06_status TEXT DEFAULT 'active',      -- active, beta, deprecated

  -- GROUP 02: BUSINESS CASE & WHY (This is the starting point - WHY before HOW)
  DB01_T02_G02_01_business_case TEXT,                -- WHY: "Increase brand visibility through automated social media"
  DB01_T02_G02_02_customer_goal TEXT,                -- What customer wants: "Save time, reach more people"
  DB01_T02_G02_03_value_proposition TEXT,            -- Value: "Automate repetitive tasks, boost engagement"
  DB01_T02_G02_04_problem_solved TEXT,               -- Problem: "Manual posting is time-consuming and inconsistent"
  DB01_T02_G02_05_target_audience TEXT,              -- Who needs this: "Marketing teams, content creators, brands"

  -- GROUP 03: USE CASES & SCENARIOS
  DB01_T02_G03_01_use_cases JSON,                    -- [{use_case: "Social media automation", scenario: "...", value: "..."}]
  DB01_T02_G03_02_examples JSON,                     -- Real-world examples: [{example: "...", outcome: "..."}]
  DB01_T02_G03_03_best_practices JSON,               -- When/how to use this capability effectively
  DB01_T02_G03_04_success_metrics JSON,              -- How to measure success: ["engagement_rate", "time_saved", "reach"]

  -- GROUP 04: CAPABILITY TAGS (for discovery and filtering)
  DB01_T02_G04_01_capability_tags JSON,              -- [social-media, automation, content-management]
  DB01_T02_G04_02_use_case_tags JSON,                -- [marketing, brand-awareness, customer-engagement]
  DB01_T02_G04_03_technical_tags JSON,               -- [real-time, batch, async, scheduled]
  DB01_T02_G04_04_business_tags JSON,                -- [revenue-generating, cost-saving, efficiency]

  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,

  FOREIGN KEY (DB01_T02_G01_04_platform_uid) REFERENCES DB01_T01_platforms(DB01_T01_G01_01_platform_uid) ON DELETE CASCADE
);

-- ENTRY NUMBERING EXAMPLE:
-- DB01_T02_G01_01_entry_001  = LinkedIn: Social Media Posting capability
-- DB01_T02_G01_01_entry_002  = GitHub: Repository Analytics capability
-- DB01_T02_G01_01_entry_003  = Firebase: Real-Time Chat capability

--====================================================================================
-- TABLE 05: PROCESSES (Sequential/Downstream Data Processing)
-- ====================================================================================
-- Table: DB01_T05_processes
-- Purpose: Define sequential processes for data transformation, filtering, post-processing
-- Entry Numbering: DB01_T05_G01_01_entry_001, DB01_T05_G01_01_entry_002, etc.
-- Flow: Action → Process (filter, transform, validate) → Next Action/Output
-- ====================================================================================

CREATE TABLE DB01_T05_processes (
  -- GROUP 01: PROCESS IDENTITY
  DB01_T05_G01_01_process_uid TEXT PRIMARY KEY,
  DB01_T05_G01_02_entry_number INTEGER,
  DB01_T05_G01_03_name TEXT NOT NULL,                -- 'Filter Results', 'Transform Data', 'Validate Output'
  DB01_T05_G01_04_action_uid TEXT NOT NULL,          -- FK to DB01_T04_actions (which action triggers this?)
  DB01_T05_G01_05_process_type TEXT,                 -- filter, transformation, validation, enrichment, aggregation
  DB01_T05_G01_06_status TEXT DEFAULT 'active',

  -- GROUP 02: PROCESS EXECUTION
  DB01_T05_G02_01_execution_order INTEGER,           -- Order in sequential pipeline (1, 2, 3...)
  DB01_T05_G02_02_is_blocking BOOLEAN DEFAULT false, -- Does this block next process?
  DB01_T05_G02_03_timeout_seconds INTEGER,
  DB01_T05_G02_04_retry_on_failure BOOLEA actions integrations and yeah deployment should goN,

  -- GROUP 03: PROCESS LOGIC
  DB01_T05_G03_01_filter_logic JSON,                 -- {field: "status", operator: "equals", value: "active"}
  DB01_T05_G03_02_transformation_logic JSON,         -- {map: {...}, reduce: {...}, format: "..."}
  DB01_T05_G03_03_validation_rules JSON,             -- {required_fields: [...], type_checks: {...}}
  DB01_T05_G03_04_output_format TEXT,                -- json, csv, xml, parquet

  -- GROUP 04: DOWNSTREAM ROUTING
  DB01_T05_G04_01_next_process_uid TEXT,             -- FK to next DB01_T05_processes
  DB01_T05_G04_02_next_action_uid TEXT,              -- FK to DB01_T04_actions
  DB01_T05_G04_03_error_handling JSON,               -- {on_error: "retry", fallback: "..."}
  DB01_T05_G04_04_success_criteria JSON,             -- When is this process successful?

  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,

  FOREIGN KEY (DB01_T05_G01_04_action_uid) REFERENCES DB01_T04_actions(DB01_T04_G01_01_action_uid) ON DELETE CASCADE,
  FOREIGN KEY (DB01_T05_G04_01_next_process_uid) REFERENCES DB01_T05_processes(DB01_T05_G01_01_process_uid) ON DELETE SET NULL,
  FOREIGN KEY (DB01_T05_G04_02_next_action_uid) REFERENCES DB01_T04_actions(DB01_T04_G01_01_action_uid) ON DELETE SET NULL
);

-- ====================================================================================
-- TABLE 08: INTERNAL_INTEGRATIONS (Data Transfer & Client Configuration)
-- ====================================================================================
-- Table: DB01_T08_internal_integrations
-- Purpose: Define how different platforms/capabilities connect internally
-- Entry Numbering: DB01_T08_G01_01_entry_001, DB01_T08_G01_01_entry_002, etc.
-- ====================================================================================

CREATE TABLE DB01_T08_internal_integrations (
  -- GROUP 01: INTEGRATION IDENTITY
  DB01_T08_G01_01_internal_integration_uid TEXT PRIMARY KEY,
  DB01_T08_G01_02_entry_number INTEGER,
  DB01_T08_G01_03_name TEXT NOT NULL,                -- 'LinkedIn to Firebase Sync', 'GitHub to Local DB'
  DB01_T08_G01_04_source_platform_uid TEXT,          -- FK to DB01_T01_platforms (data source)
  DB01_T08_G01_05_target_platform_uid TEXT,          -- FK to DB01_T01_platforms (data destination)
  DB01_T08_G01_06_status TEXT DEFAULT 'active',

  -- GROUP 02: SOURCE & TARGET CONFIGURATION
  DB01_T08_G02_01_source_capability_uid TEXT,        -- FK to DB01_T02_capabilities
  DB01_T08_G02_02_target_capability_uid TEXT,        -- FK to DB01_T02_capabilities
  DB01_T08_G02_03_source_action_uid TEXT,            -- FK to DB01_T04_actions (which action pulls data?)
  DB01_T08_G02_04_target_action_uid TEXT,            -- FK to DB01_T04_actions (which action receives data?)

  -- GROUP 03: DATA TRANSFER CONFIGURATION
  DB01_T08_G03_01_transfer_method TEXT,              -- push, pull, streaming, batch, event-driven
  DB01_T08_G03_02_transfer_frequency TEXT,           -- real-time, hourly, daily, on-demand
  DB01_T08_G03_03_data_format TEXT,                  -- json, csv, parquet, avro, protobuf
  DB01_T08_G03_04_transformation_rules JSON,         -- Data transformation during transfer
  DB01_T08_G03_05_batch_size INTEGER,                -- For batch transfers

  -- GROUP 04: CLIENT CONFIGURATION & POLICIES
  DB01_T08_G04_01_client_config JSON,                -- Client-specific configuration
  DB01_T08_G04_02_retry_policy JSON,                 -- {max_retries: 3, backoff: "exponential"}
  DB01_T08_G04_03_error_handling JSON,               -- How to handle transfer failures
  DB01_T08_G04_04_data_validation JSON,              -- Validation rules for transferred data

  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,

  FOREIGN KEY (DB01_T08_G01_04_source_platform_uid) REFERENCES DB01_T01_platforms(DB01_T01_G01_01_platform_uid) ON DELETE CASCADE,
  FOREIGN KEY (DB01_T08_G01_05_target_platform_uid) REFERENCES DB01_T01_platforms(DB01_T01_G01_01_platform_uid) ON DELETE CASCADE
);

====================================================================================
-- TABLE 04: ACTIONS (What Specific Actions Can We Take?)
-- ====================================================================================
-- Table: DB01_T04_actions
-- Purpose: Define specific actions/endpoints for each integration type
-- Entry Numbering: DB01_T04_G01_01_entry_001, DB01_T04_G01_01_entry_002, etc.
-- Includes: action_type, execution_tags, workflow_id for orchestration
-- ====================================================================================

CREATE TABLE DB01_T04_actions (
  -- GROUP 01: ACTION IDENTITY
  DB01_T04_G01_01_action_uid TEXT PRIMARY KEY,
  DB01_T04_G01_02_entry_number INTEGER,
  DB01_T04_G01_03_name TEXT NOT NULL,                -- 'create_post', 'get_analytics', 'send_message'
  DB01_T04_G01_04_integration_uid TEXT NOT NULL,     -- FK to DB01_T03_integration_types
  DB01_T04_G01_05_action_type TEXT,                  -- read, write, delete, execute, stream, batch
  DB01_T04_G01_06_status TEXT DEFAULT 'active',

  -- GROUP 02: ENDPOINT & METHOD INFO
  DB01_T04_G02_01_endpoint TEXT,                     -- '/posts', '/analytics', '/messages'
  DB01_T04_G02_02_http_method TEXT,                  -- GET, POST, PUT, DELETE, PATCH, WEBSOCKET
  DB01_T04_G02_03_request_format TEXT,               -- json, form-data, xml, binary
  DB01_T04_G02_04_response_format TEXT,              -- json, xml, stream, binary

  -- GROUP 03: ACTION METADATA & EXECUTION
  DB01_T04_G03_01_execution_tags JSON,               -- [async, sync, queued, scheduled, real-time]
  DB01_T04_G03_02_retry_policy JSON,                 -- {max_retries: 3, backoff: "exponential"}
  DB01_T04_G03_03_timeout_seconds INTEGER,
  DB01_T04_G03_04_idempotent BOOLEAN,                -- Can this action be safely retried?
  DB01_T04_G03_05_cacheable BOOLEAN,

  -- GROUP 04: POLICIES & SECURITY
  DB01_T04_G04_01_auth_required BOOLEAN DEFAULT true,
  DB01_T04_G04_02_permissions_required JSON,         -- Required permissions to execute
  DB01_T04_G04_03_rate_limit JSON,                   -- Action-specific rate limits
  DB01_T04_G04_04_data_sensitivity TEXT,             -- public, internal, confidential, restricted
  DB01_T04_G04_05_compliance_requirements JSON,      -- [GDPR, HIPAA, SOC2]

  -- GROUP 05: WORKFLOW & ORCHESTRATION
  DB01_T04_G05_01_workflow_id TEXT,                  -- Link to DB01_T06_workflows for orchestrated execution
  DB01_T04_G05_02_triggers_workflow BOOLEAN,         -- Does this action trigger a workflow?
  DB01_T04_G05_03_workflow_position INTEGER,         -- Position in workflow (1=first, 2=second, etc.)
  DB01_T04_G05_04_depends_on_actions JSON,           -- Actions that must complete first

  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,

  FOREIGN KEY (DB01_T04_G01_04_integration_uid) REFERENCES DB01_T03_integration_types(DB01_T03_G01_01_integration_uid) ON DELETE CASCADE,
  FOREIGN KEY (DB01_T04_G05_01_workflow_id) REFERENCES DB01_T06_workflows(DB01_T06_G01_01_workflow_uid) ON DELETE SET NULL
);

---
