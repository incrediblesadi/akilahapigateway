#tool temp ideaition
contract:
  id: utility.timestamp
  name: Timestamp Utility Tool
  version: 1.0.0
  category: utility.time
  description: >
    Generates a canonical UTC timestamp snapshot and optional derived
    projections including human-readable formats, indexing metadata,
    and range calculations. Supports multiple output formats and
    optional execution-scoped state reuse.

  state:
    enabled: true
    scope: execution   # execution | workflow | none
    key: timestamp_snapshot

  input:
    timezone:
      type: string
      default: UTC
      description: IANA timezone string (e.g., America/New_York)

    output_mode:
      type: string
      enum: [canonical, human, indexing, ranges, full]
      default: full
      description: Determines which projection layers are included

    output_format:
      type: string
      enum: [json, yaml, markdown, sqlite, raw]
      default: json
      description: Output format transformation

    interactive:
      type: boolean
      default: false
      description: If true, prompt user for selections via CLI

  output_schema:
    canonical:
      utc_iso: string
      uid: string
      unix_epoch_ms: number

    human:
      timezone: string
      human_readable: string
      short: string
      date_only: string
      time_only: string

    indexing:
      year: number
      month: number
      month_name: string
      week_number: number
      quarter: number
      day_of_week: string

    ranges:
      start_of_day: string
      end_of_day: string
      start_of_week: string
      end_of_week: string

  runtime:
    type: bash
    entry: inline

  script: |
    #!/usr/bin/env bash

    # ---------- INPUT DEFAULTS ----------
    TZ_INPUT="${timezone:-UTC}"
    OUTPUT_MODE="${output_mode:-full}"
    OUTPUT_FORMAT="${output_format:-json}"

    # ---------- BASE TIMESTAMP ----------
    BASE_UTC=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    UNIX_EPOCH_MS=$(($(date +%s%N)/1000000))
    UID=$(date -u +"%Y%m%dT%H%M%S%3NZ")

    # ---------- TIMEZONE PROJECTION ----------
    LOCAL_DATE=$(TZ=$TZ_INPUT date +"%Y-%m-%d")
    LOCAL_TIME=$(TZ=$TZ_INPUT date +"%H:%M:%S")
    HUMAN_READABLE=$(TZ=$TZ_INPUT date +"%A, %B %d, %Y %I:%M %p %Z")
    SHORT=$(TZ=$TZ_INPUT date +"%m/%d/%Y %I:%M %p")

    # ---------- INDEXING ----------
    YEAR=$(TZ=$TZ_INPUT date +"%Y")
    MONTH=$(TZ=$TZ_INPUT date +"%m")
    MONTH_NAME=$(TZ=$TZ_INPUT date +"%B")
    WEEK_NUMBER=$(TZ=$TZ_INPUT date +"%V")
    DAY_OF_WEEK=$(TZ=$TZ_INPUT date +"%A")

    # Quarter calculation
    MONTH_INT=$((10#$MONTH))
    QUARTER=$(( (MONTH_INT - 1) / 3 + 1 ))

    # ---------- RANGES ----------
    START_OF_DAY=$(TZ=$TZ_INPUT date +"%Y-%m-%dT00:00:00")
    END_OF_DAY=$(TZ=$TZ_INPUT date +"%Y-%m-%dT23:59:59")

    # Start of week (Monday)
    START_OF_WEEK=$(TZ=$TZ_INPUT date -d "last monday" +"%Y-%m-%dT00:00:00")
    END_OF_WEEK=$(TZ=$TZ_INPUT date -d "next sunday" +"%Y-%m-%dT23:59:59")

    # ---------- BUILD CANONICAL JSON ----------
    JSON_OUTPUT=$(cat <<EOF
    {
      "canonical": {
        "utc_iso": "$BASE_UTC",
        "uid": "$UID",
        "unix_epoch_ms": $UNIX_EPOCH_MS
      },
      "human": {
        "timezone": "$TZ_INPUT",
        "human_readable": "$HUMAN_READABLE",
        "short": "$SHORT",
        "date_only": "$LOCAL_DATE",
        "time_only": "$LOCAL_TIME"
      },
      "indexing": {
        "year": $YEAR,
        "month": $MONTH_INT,
        "month_name": "$MONTH_NAME",
        "week_number": $WEEK_NUMBER,
        "quarter": $QUARTER,
        "day_of_week": "$DAY_OF_WEEK"
      },
      "ranges": {
        "start_of_day": "$START_OF_DAY",
        "end_of_day": "$END_OF_DAY",
        "start_of_week": "$START_OF_WEEK",
        "end_of_week": "$END_OF_WEEK"
      }
    }
    EOF
    )

    # ---------- OUTPUT FORMAT HANDLING ----------
    if [ "$OUTPUT_FORMAT" = "json" ]; then
      echo "$JSON_OUTPUT"

    elif [ "$OUTPUT_FORMAT" = "yaml" ]; then
      echo "$JSON_OUTPUT" | yq

    elif [ "$OUTPUT_FORMAT" = "markdown" ]; then
      echo "| Field | Value |"
      echo "|-------|-------|"
      echo "| UTC ISO | $BASE_UTC |"
      echo "| Human | $HUMAN_READABLE |"
      echo "| Week | $WEEK_NUMBER |"
      echo "| Quarter | $QUARTER |"

    elif [ "$OUTPUT_FORMAT" = "sqlite" ]; then
      echo "INSERT INTO timestamps (utc_iso, uid, epoch_ms) VALUES ('$BASE_UTC', '$UID', $UNIX_EPOCH_MS);"

    else
      echo "$BASE_UTC"
    fi




-- ====================================================================================
-- TABLE 06: WORKFLOWS (Automated Workflows Triggered by Actions/Events)
-- ====================================================================================
-- Table: DB01_T06_workflows
-- Purpose: Define automated workflows with triggers, steps, and orchestration
-- Entry Numbering: DB01_T06_G01_01_entry_001, DB01_T06_G01_01_entry_002, etc.
-- Links to: DB01_T04_actions (workflow_id), DB01_T02_capabilities
-- ====================================================================================

CREATE TABLE DB01_T06_workflows (
  -- GROUP 01: WORKFLOW IDENTITY
  DB01_T06_G01_01_workflow_uid TEXT PRIMARY KEY,
  DB01_T06_G01_02_entry_number INTEGER,
  DB01_T06_G01_03_name TEXT NOT NULL,                -- 'Social Media Post Pipeline', 'Data Sync Workflow'
  DB01_T06_G01_04_capability_uid TEXT,               -- FK to DB01_T02_capabilities (what capability does this serve?)
  DB01_T06_G01_05_workflow_type TEXT,                -- sequential, parallel, conditional, event-driven
  DB01_T06_G01_06_status TEXT DEFAULT 'active',

  -- GROUP 02: TRIGGERS & INITIATION
  DB01_T06_G02_01_trigger_type TEXT,                 -- manual, scheduled, event, webhook, action-completion
  DB01_T06_G02_02_trigger_event TEXT,                -- Which event starts this? (action_completed, data_received, time_scheduled)
  DB01_T06_G02_03_trigger_conditions JSON,           -- Conditions for trigger: {field: "...", operator: "...", value: "..."}
  DB01_T06_G02_04_schedule_cron TEXT,                -- Cron expression if scheduled

  -- GROUP 03: EXECUTION STEPS
  DB01_T06_G03_01_workflow_steps JSON,               -- [{step: 1, action_uid: "...", wait_for_completion: true}, ...]
  DB01_T06_G03_02_step_dependencies JSON,            -- Dependencies between steps
  DB01_T06_G03_03_parallel_execution BOOLEAN,        -- Can steps run in parallel?
  DB01_T06_G03_04_error_handling JSON,               -- {on_error: "rollback", retry_failed_steps: true}

  -- GROUP 04: ORCHESTRATION & SCHEDULING
  DB01_T06_G04_01_orchestrator TEXT,                 -- temporal, airflow, step-functions, custom
  DB01_T06_G04_02_max_execution_time INTEGER,        -- Maximum workflow runtime in seconds
  DB01_T06_G04_03_retry_policy JSON,                 -- {max_retries: 3, backoff: "exponential"}
  DB01_T06_G04_04_success_criteria JSON,             -- When is workflow successful?

  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,

  FOREIGN KEY (DB01_T06_G01_04_capability_uid) REFERENCES DB01_T02_capabilities(DB01_T02_G01_01_capability_uid) ON DELETE CASCADE
);
