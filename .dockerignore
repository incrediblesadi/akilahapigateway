# === Deployment Ignore List ===

# Environment and secrets
.env
currentsecrets.env
secret.env
*.secret
*.key
*.pem

# Local development and logs
node_modules/
*.log
*.test.js
coverage/
build/
dist/

# Service and workflow artifacts
/.firebase/
firebase-debug.log
service-account.json
credentials/
*.bak

# GitHub workflows and auto-generated files (if not production critical)
.github/
scripts/generate-file-contents.js

# Notion-specific SDK or test clients
clients/notionClient.js
clients/githubClient.js

# Cache and IDE-specific
.DS_Store
.vscode/
.idea/
# Documentation files (not needed in production)
*.md
!README.md
ARCHITECTURE-AND-FEATURES.md
CHANGELOG.md
DETAILED-ACTION-PLAN.md
EXECUTIVE-SUMMARY.md
PROJECT-ANALYSIS-INVESTOR-BRIEF.md
README-ENV-TO-SECRETS.md
remodel-plan.md
"REPO MAP.md"
REPO-MAP_DEV.md
START-HERE.md

# Test and build artifacts
test/
bin/
cloudbuild.yaml
Dockerfile
